{
  "manifest_version": 3,
  "name": "Disney+ Legacy Link Redirector",
  "version": "1.0.0",
  "description": "Redirect Disney+ regional movie and series links to matching Disney+ title pages when a verified mapping is available.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": [
    "https://www.wikidata.org/*",
    "https://www.bing.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Disney+ Link Redirector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}